APP_URL=http://localhost:3000
DATA_DIR=./data

# Optional S3-compatible object storage. Leave blank to store uploads locally.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Optional single-user password gate. Keep empty for local development only.
AUTH_PASSWORD=
AUTH_SECRET=replace-with-a-long-random-string
