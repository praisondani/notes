APP_URL=http://localhost:3000
DATA_DIR=./data

# Optional S3-compatible object storage. Leave blank to store uploads locally.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Optional single-user password gate. Keep empty for local development only.
AUTH_PASSWORD=
AUTH_SECRET=replace-with-a-long-random-string

# MCP access. HTTP MCP is disabled until a token is configured.
# Prefer the token-file CLI for multiple, revocable credentials.
MCP_ACCESS_TOKEN=
MCP_ACCESS_TOKEN_SCOPES=notes:read,notes:write
MCP_ALLOWED_HOSTS=localhost:3000
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=120
# Set to 1 when a local stdio agent must be read-only.
MCP_STDIO_READ_ONLY=0
