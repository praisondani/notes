APP_URL=http://localhost:3000
DATA_DIR=./data

# Optional S3-compatible object storage. Leave blank to store uploads locally.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# First-run owner account. AUTH_PASSWORD is migrated once into data/auth.json for older installs.
AUTH_USERNAME=admin
AUTH_EMAIL=owner@notes.local
AUTH_PASSWORD=
AUTH_SECRET=replace-with-a-long-random-string

# MCP access. Browser-based OAuth is enabled automatically using APP_URL and the owner account.
# Set MCP_RESOURCE_URL only when the public MCP resource URL differs from APP_URL/api/mcp.
MCP_RESOURCE_URL=
# Optional legacy bearer-token fallback for scripts and older clients.
MCP_ACCESS_TOKEN=
MCP_ACCESS_TOKEN_SCOPES=notes:read,notes:write
MCP_ALLOWED_HOSTS=localhost:3000
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=120
# Set to 1 when a local stdio agent must be read-only.
MCP_STDIO_READ_ONLY=0
