{
  "name": "notes",
  "version": "0.3.0",
  "private": false,
  "description": "A minimal, self-hostable private note workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "lint": "eslint app src scripts next.config.ts vitest.config.ts eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "mcp:token": "node scripts/mcp-token.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.856.0",
    "@aws-sdk/s3-request-presigner": "^3.856.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.17.58",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
